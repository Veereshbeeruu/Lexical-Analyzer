/* MAIN FUNCTION */

int main()
{
    char source[MAX] = "";

    char *menu[] =
    {
        "VIEW",
        "HELP",
        "EDIT",
        "INSERT",
        "EXIT"
    };

    int option;
    int i;

    while(1)
    {
        printf("\n====================================================\n");
        printf("              LEXICAL ANALYZER PROJECT\n");
        printf("====================================================\n");

        for(i = 0; i < 5; i++)
        {
            printf("%d. %s\n",
                   i + 1,
                   menu[i]);
        }

        printf("\nSelect the option: ");
        scanf("%d", &option);
        getchar();

        if(option < 1 || option > 5)
        {
            printf("\nInvalid option\n");
            continue;
        }

        printf("\n%s is selected\n",
               menu[option - 1]);

        switch(option)
        {
            case 1:
                viewSource(source);
                break;

            case 2:
                help();
                break;

            case 3:
                editSource(source);
                break;

            case 4:
                insertSource(source);
                break;

            case 5:
                printf("\nExiting Lexical Analyzer...\n");
                return 0;
        }
    }

    return 0;
}
